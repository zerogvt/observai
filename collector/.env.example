# Copy to .env. DO NOT COMMIT the real file — add `.env` to .gitignore.
# The real token should only ever live here, never in code or in git.

# --- Dynatrace OTLP endpoint ---
# Find your environment ID in your Dynatrace URL.
#   SaaS:    https://<env-id>.live.dynatrace.com/api/v2/otlp
#   Managed: https://<your-domain>/e/<env-id>/api/v2/otlp
# (The Collector appends /v1/traces and /v1/metrics itself — give the base.)
DT_OTLP_ENDPOINT=https://<env-id>.live.dynatrace.com/api/v2/otlp

# --- Dynatrace API token ---
# Create in Dynatrace: Settings > Access Tokens > Generate new token.
# Scopes needed for OTLP ingest (exact labels vary slightly by version):
#   - openTelemetryTrace.ingest   (traces)
#   - metrics.ingest              (metrics)
#   - logs.ingest                 (only if you add logs later)
DT_API_TOKEN=dt0c01.XXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

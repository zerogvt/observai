# Copy to .env and adjust. These map 1:1 to config.py.

# Service identity (shows up in your traces)
SERVICE_NAME=gateway
SERVICE_VERSION=0.1.0
ENV=local

# Where the inference service lives
INFERENCE_URL=http://localhost:8001/infer
INFERENCE_TIMEOUT_S=60

# OpenTelemetry -> Collector -> Dynatrace
# Set OTEL_ENABLED=false locally if you have no Collector running; spans
# will print to the console instead.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Rate limiting (use a redis:// URI once you run >1 replica)
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_PROMPT=10 per minute
RATE_LIMIT_STORAGE_URI=memory://

# Validation bounds
MAX_INPUT_CHARS=20000
ALLOWED_TASKS=summarize,chat,classify,extract

# Human-oversight: flag responses below this confidence for review
OVERSIGHT_CONFIDENCE_FLOOR=0.6

# feature: flagged chats sink — the auditable record of flagged prompts and
# replies (audit.py). Exported as OTLP logs, so the Collector needs a `logs`
# pipeline and the Dynatrace token needs the `logs.ingest` scope.
AUDIT_ENABLED=true
# Metadata-only row for unflagged responses too, so the flagged count has a
# denominator an auditor can reconcile against.
AUDIT_RECORD_UNFLAGGED=true
# Retain prompt/reply text on flagged rows. Turn off, or switch to hashing,
# wherever real user data flows through.
AUDIT_LOG_CONTENT=true
AUDIT_HASH_CONTENT=false
# Cap per text field. The sha256 always covers the full text, so truncating
# here doesn't cost you provability.
AUDIT_MAX_TEXT_CHARS=2000

# Dev server port
PORT=8000

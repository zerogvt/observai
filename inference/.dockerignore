# Keep the build context small and keep secrets / dev-only files out of the image.

# Secrets — never copy real env files into an image
.env
.env.*
!.env.example

# Tests and dev tooling (not needed at runtime)
tests/
pytest.ini
requirements-dev.txt
fake_ollama.py

# Python caches / virtualenvs
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Docs / VCS / editor noise
README.md
.git/
.gitignore
.idea/
.vscode/

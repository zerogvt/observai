# Copy to .env and adjust. Maps 1:1 to config.py.

SERVICE_NAME=inference
SERVICE_VERSION=0.1.0
ENV=local
PORT=8001

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_S=120
MAX_OUTPUT_TOKENS=512
TEMPERATURE=0.7

# OpenTelemetry -> Collector -> Dynatrace
# Set OTEL_ENABLED=false locally if you have no Collector; spans + metrics
# print to the console instead.
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Confidence proxy: below this, the response is flagged for human review
CONFIDENCE_REVIEW_FLOOR=0.6
